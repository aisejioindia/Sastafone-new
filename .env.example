# GEMINI_API_KEY: Required for Gemini AI API calls (if server features are enabled).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Deployed public URL (e.g. https://sastafone.in).
APP_URL="https://sastafone.in"

# Razorpay Payment Gateway Credentials (Server-side)
RAZORPAY_KEY_ID="rzp_live_xxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"
